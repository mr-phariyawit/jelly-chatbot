# JVC IT Support Assistant - Environment Variables
# Copy this file to .env.local and fill in your values

# Firebase Project
GCLOUD_PROJECT=jvc-it-support

# LINE Official Account Credentials
# Get from LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# JIRA API Token
# Get from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your_email@jventures.asia
JIRA_API_TOKEN=your_api_token_here

# Gemini API (Optional - uses Vertex AI by default)
GEMINI_API_KEY=your_gemini_api_key_here
